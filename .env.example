# CITINEL - environment template.
#
# Copy to `.env` and fill in. `.env` is gitignored and never committed.
# Variable NAMES only below; no values are ever stored in the repository.
#
# Nothing in Stage 1 (ingest -> OCSF -> Sigma -> anomaly scoring) needs any
# of these. They come into play from Step 7 onward.

# --- the agent swarm (Step 7) -------------------------------------------
CITINEL_ANTHROPIC_API_KEY=
# Model ids are checked live before use, per CITINEL-STATE.md Section 5
# item 6 (ledger duty L9). Do not paste a name here from memory.
CITINEL_TRIAGE_MODEL=
CITINEL_REASONING_MODEL=

# --- enrichment squad (Step 7) ------------------------------------------
# Free tiers with hard caps. VirusTotal is 4 req/min and 500/day, which is
# why enrichment is cache-first with hash dedup (PIPE-F04, AGT-F10) - the
# cap must never be able to fire mid-demo.
CITINEL_TAVILY_API_KEY=
CITINEL_VIRUSTOTAL_API_KEY=
CITINEL_ABUSEIPDB_API_KEY=

# --- persistence (Step 6) -----------------------------------------------
CITINEL_DATABASE_URL=
CITINEL_REDIS_URL=

# --- sponsor integrations (Step 12) -------------------------------------
CITINEL_N8N_WEBHOOK_URL=
CITINEL_SWYTCHCODE_API_KEY=
CITINEL_LYZR_API_KEY=

# --- safety rails --------------------------------------------------------
# Leave this true. Response actions hit mocked endpoints only (PIPE-F09).
CITINEL_SIMULATED_ENDPOINTS_ONLY=true
# shadow | assist | autonomous. Conservative default is deliberate.
CITINEL_DEFAULT_AUTONOMY=shadow
