# CITINEL - environment template.
#
# Copy to `.env` and fill in. `.env` is gitignored and never committed.
# Variable NAMES only below; no values are ever stored in the repository.
#
# Nothing in Stage 1 (ingest -> OCSF -> Sigma -> anomaly scoring) needs any
# of these. They come into play from Step 7 onward.

# --- the agent swarm (Step 7) -------------------------------------------
CITINEL_ANTHROPIC_API_KEY=
CITINEL_ANTHROPIC_WORKSPACE_ID=
# Model ids are checked live before use, per CITINEL-STATE.md Section 5
# item 6 (ledger duty L9). Do not paste a name here from memory.
CITINEL_TRIAGE_MODEL=
CITINEL_REASONING_MODEL=

# --- enrichment squad (Step 7) ------------------------------------------
# Free tiers with hard caps. VirusTotal is 4 req/min and 500/day, which is
# why enrichment is cache-first with hash dedup (PIPE-F04, AGT-F10) - the
# cap must never be able to fire mid-demo.
CITINEL_TAVILY_API_KEY=
CITINEL_VIRUSTOTAL_API_KEY=
CITINEL_ABUSEIPDB_API_KEY=

# --- persistence (Step 6) -----------------------------------------------
CITINEL_DATABASE_URL=
CITINEL_REDIS_URL=

# --- sponsor integrations (Step 12) -------------------------------------
CITINEL_N8N_WEBHOOK_URL=
CITINEL_SWYTCHCODE_API_KEY=
CITINEL_LYZR_API_KEY=
# Lyzr Agent API endpoint + agent id for the PII/hallucination second-check.
# Take the exact host from your Lyzr Studio (it is per-deployment); the
# connector adds it to the egress allow-list only when set.
CITINEL_LYZR_GUARD_URL=
CITINEL_LYZR_AGENT_ID=

# --- safety rails --------------------------------------------------------
# Leave this true. Response actions hit mocked endpoints only (PIPE-F09).
CITINEL_SIMULATED_ENDPOINTS_ONLY=true
# shadow | assist | autonomous. Conservative default is deliberate.
CITINEL_DEFAULT_AUTONOMY=shadow
# Leave false. The worker auto-running the swarm on every CAUGHT incident
# risks silently re-billing already-investigated incidents on a rebuild
# (see worker/run.py). Real, per-incident API cost -- opt in deliberately.
CITINEL_AUTO_SWARM=false
CITINEL_AUTO_SWARM_MAX_PER_CYCLE=3

# Additional Lyzr Studio agents (connectors/lyzr_agents.py). Each is optional; an
# unset id makes that seam report not_configured. Recipes: LYZR-AGENT-CONFIG.md.
CITINEL_LYZR_TRIAGE_AGENT_ID=
CITINEL_LYZR_REVIEW_AGENT_ID=
CITINEL_LYZR_HANDOVER_AGENT_ID=

# Only the CITINEL_-prefixed names are read. If a deployment reports every
# connector "not configured", GET /api/connectors carries an "environment"
# block: for each expected variable whether it is set, blank or absent, which
# unprefixed spellings (ANTHROPIC_API_KEY, ...) exist but are NOT read, which
# dotenv locations (.env here, /app/.env, /etc/secrets/.env) exist and which
# expected keys they define. Fixed names only; never a value. A blank value
# means unset and does not override an earlier source.
