{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/evidence/**",
              "components/forms/**",
              "components/indicators/**",
              "components/instruments/**",
              "ui_kits/console/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Michroma|Orbitron|IBM Plex Sans))/i]",
        "message": "Font not provided by the design system. Available: Michroma, Orbitron, IBM Plex Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|approve|deny|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'approve' | 'deny' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CitationChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:locator|onClick|size|title|style|key|ref|className|style|children)$/]",
        "message": "<CitationChip> doesn't accept that prop. Declared props: locator, onClick, size, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CitationChip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<CitationChip> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormControls'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|mono|options|checked|onChange|disabled|style|key|ref|className|style|children)$/]",
        "message": "<FormControls> doesn't accept that prop. Declared props: label, mono, options, checked, onChange, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogWell'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|quoted|dense|style|key|ref|className|style|children)$/]",
        "message": "<LogWell> doesn't accept that prop. Declared props: children, quoted, dense, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Provenance'] > JSXAttribute > JSXIdentifier[name!=/^(?:timestamp|source|hash|style|key|ref|className|style|children)$/]",
        "message": "<Provenance> doesn't accept that prop. Declared props: timestamp, source, hash, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuarantineWell'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|timestamp|source|hash|style|key|ref|className|style|children)$/]",
        "message": "<QuarantineWell> doesn't accept that prop. Declared props: children, timestamp, source, hash, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SeverityBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|size|style|key|ref|className|style|children)$/]",
        "message": "<SeverityBadge> doesn't accept that prop. Declared props: level, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SeverityBadge'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:critical|high|medium|low)$/]",
        "message": "<SeverityBadge> level must be one of 'critical' | 'high' | 'medium' | 'low'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SeverityBadge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<SeverityBadge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sparkline'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|width|height|stroke|label|value|style|key|ref|className|style|children)$/]",
        "message": "<Sparkline> doesn't accept that prop. Declared props: data, width, height, stroke, label, value, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StateChain'] > JSXAttribute > JSXIdentifier[name!=/^(?:current|denied|showLabels|width|style|key|ref|className|style|children)$/]",
        "message": "<StateChain> doesn't accept that prop. Declared props: current, denied, showLabels, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StateChain'] > JSXAttribute[name.name='current'] > Literal[value!=/^(?:caught|cited|gated|actioned|closed)$/]",
        "message": "<StateChain> current must be one of 'caught' | 'cited' | 'gated' | 'actioned' | 'closed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatutoryClock'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|deadline|elapsedFrom|variant|size|framed|style|key|ref|className|style|children)$/]",
        "message": "<StatutoryClock> doesn't accept that prop. Declared props: label, deadline, elapsedFrom, variant, size, framed, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatutoryClock'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:statutory|info)$/]",
        "message": "<StatutoryClock> variant must be one of 'statutory' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatutoryClock'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<StatutoryClock> size must be one of 'sm' | 'md' | 'lg'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
