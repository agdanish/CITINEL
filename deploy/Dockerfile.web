# CITINEL web service: glass-box dashboard + API (Best Use of Render).
FROM python:3.11-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

# Dependencies first for layer caching.
COPY backend/pyproject.toml /app/backend/pyproject.toml
RUN pip install --upgrade pip && pip install "/app/backend[swarm,api,detect]" || true

COPY backend /app/backend
COPY policies /app/policies
RUN pip install /app/backend[swarm,api]

# Render provides $PORT; the web role binds it.
ENV CITINEL_ROLE=web
EXPOSE 8000
CMD ["sh", "-c", "uvicorn citinel.web.app:app --host 0.0.0.0 --port ${PORT:-8000}"]
